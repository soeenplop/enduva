{
  "name": "@spike/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file ../.swcrc",
    "generate": "pnpm run build && node dist/generate-openapi.js openapi.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7",
    "zod-openapi": "6.0.3"
  },
  "devDependencies": {
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.11",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  }
}
