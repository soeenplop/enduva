{
  "name": "ts7-toolchain-spike",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "pnpm -r --workspace-concurrency=1 run generate",
    "db:generate": "pnpm --filter @spike/api run db:generate",
    "typecheck": "pnpm -r run typecheck",
    "test:negative": "node scripts/negative-tests.mjs",
    "audit:lockfile": "node scripts/audit-lockfile.mjs --self-test && node scripts/audit-lockfile.mjs pnpm-lock.yaml ../../pnpm-lock.yaml",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "smoke": "node scripts/smoke.mjs && node scripts/ssr-isolation.mjs",
    "check:prerender": "node scripts/check-prerender.mjs landing/dist/client",
    "swift:openapi": "cp contracts/openapi.json swift-client/Sources/SpikeAPIClient/openapi.json"
  },
  "devDependencies": {
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "typescript": "7.0.2"
  }
}
