        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 100
          },
          "birthDate": {
            "format": "date",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "sex": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "female",
              "male",
              null
            ]
          },
          "heightCm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 50,
            "maximum": 300
          },
          "locale": {
            "type": "string",
            "enum": [
              "de",
              "en"
            ]
          },
          "timeZone": {
            "type": "string",
            "description": "IANA time zone, as ICU's canonical ID"
