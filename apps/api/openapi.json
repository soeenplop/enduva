          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "description": "Stable error code: bad_request, unauthorized, device_revoked, forbidden, not_found, method_not_allowed, precondition_failed, payload_too_large, unsupported_media_type, precondition_required, rate_limited, internal_error, database_unavailable, auth_unavailable"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ]
      },
