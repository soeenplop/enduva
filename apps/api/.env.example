# Environment of @enduva/api. Copy to apps/api/.env for `pnpm dev` (gitignored). The API refuses to start if a value
# is missing or invalid. The values below are for the LOCAL Supabase stack only (`pnpm --filter @enduva/db db:start`).

# Required. Transaction pooler, as the API login (ADR-0002). Hosted: postgresql://enduva_api_login.<project-ref>:…@…:6543/postgres
DATABASE_URL=postgresql://enduva_api_login.pooler-dev:enduva-local-api@127.0.0.1:54329/postgres

# Required. Supabase Auth issuer, compared exactly with the token's `iss`. Hosted: https://<project-ref>.supabase.co/auth/v1
AUTH_ISSUER=http://127.0.0.1:54321/auth/v1

# Optional, defaults shown.
# AUTH_JWT_ALGORITHM=ES256
# NODE_ENV=development
# HOST=0.0.0.0
# PORT=3000
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# Traefik's own address(es), or a subnet only trusted proxies can join; never the shared dokploy-network subnet
# or uniquelocal (README → Client IPs). Example: TRUST_PROXY=10.0.1.5
# TRUST_PROXY=
# THROTTLE_LIMIT=100
# THROTTLE_TTL_SECONDS=60
