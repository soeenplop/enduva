#include "App.xcconfig"

// A single-target watchOS app, embedded in the iPhone app and able to run without it (the Watch gets its own
// device session in 2.8a, ADR-0005).
PRODUCT_NAME = EnduvaWatch
PRODUCT_BUNDLE_IDENTIFIER = $(ENDUVA_BUNDLE_ID).watchkitapp
SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
TARGETED_DEVICE_FAMILY = 4
SKIP_INSTALL = YES
INFOPLIST_KEY_WKCompanionAppBundleIdentifier = $(ENDUVA_BUNDLE_ID)
INFOPLIST_KEY_WKRunsIndependentlyOfCompanionApp = YES
