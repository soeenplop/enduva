{
  "name": "@enduva/landing",
  "version": "0.0.0",
  "private": true,
  "description": "Landing page, prerendered to static HTML under /de/… and /en/… (T4).",
  "type": "module",
  "scripts": {
    "generate": "node scripts/compile-paraglide.mjs && tsr generate",
    "dev": "vite dev",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c node_modules/@enduva/config/oxlint.json --type-aware --deny-warnings --ignore-pattern 'src/paraglide/**' --ignore-pattern src/routeTree.gen.ts src test scripts *.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@enduva/ui": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@enduva/config": "workspace:*",
    "@enduva/i18n": "workspace:*",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.2",
    "@tanstack/router-cli": "1.168.0",
    "@types/node": "catalog:",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
