{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "embeddedLanguageFormatting": "off",
  "sortPackageJson": false,
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "assets/**",
    "**/dist/**",
    "**/*.md",
    "**/*.yaml",
    "**/*.yml",
    "spikes/**",
    "supabase/migrations/meta/**",
    "tools/fixtures/**",
    "apps/api/openapi.json",
    "packages/api-client/src/generated/**",
    "apps/apple/**/*.xcassets/**",
    "apps/apple/**/*.icon/**"
  ]
}
