{
  "name": "@enduva/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas, DTO types and OpenAPI generation, shared by API and web.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --delete-dir-on-start --config-file node_modules/@enduva/config/swc/lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c node_modules/@enduva/config/oxlint.json --type-aware --deny-warnings src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@enduva/config": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
