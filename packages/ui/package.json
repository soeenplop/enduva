{
  "name": "@enduva/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React components and design tokens.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --delete-dir-on-start --config-file node_modules/@enduva/config/swc/react.json && node generate-css.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c node_modules/@enduva/config/oxlint.json --type-aware --deny-warnings src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@enduva/config": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
