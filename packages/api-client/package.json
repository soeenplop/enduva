{
  "name": "@enduva/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed fetch client for the Enduva API, generated by Orval from apps/api/openapi.json.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "orval --config orval.config.mjs",
    "build": "swc src -d dist --strip-leading-paths --delete-dir-on-start --config-file node_modules/@enduva/config/swc/lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c node_modules/@enduva/config/oxlint.json --type-aware --deny-warnings --ignore-pattern 'src/generated/**' src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@enduva/config": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "orval": "8.49.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
