{
  "name": "@enduva/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, queries and seed scripts.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --delete-dir-on-start --config-file node_modules/@enduva/config/swc/lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint -c node_modules/@enduva/config/oxlint.json --type-aware --deny-warnings src test",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "db:keys": "node scripts/ensure-signing-key.mjs",
    "db:start": "pnpm db:keys && supabase start --workdir ../..",
    "db:stop": "supabase stop --workdir ../..",
    "db:reset": "supabase db reset --workdir ../..",
    "db:generate": "drizzle-kit generate --config drizzle.config.mjs",
    "db:custom": "drizzle-kit generate --config drizzle.config.mjs --custom"
  },
  "devDependencies": {
    "@enduva/config": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "jose": "6.2.18",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  }
}
