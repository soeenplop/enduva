{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["packages/config/**"],
  "tasks": {
    "generate": {
      "outputs": ["src/routeTree.gen.ts", "src/paraglide/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "@enduva/landing#build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/brand/final/web/**"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit", "generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit", "generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "transit", "generate"],
      "outputs": []
    },
    "@enduva/api#test": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": []
    },
    "@enduva/tools#test": {
      "cache": false
    },
    "//#format:check": {
      "cache": false
    }
  }
}
