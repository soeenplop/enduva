{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["packages/config/**"],
  "tasks": {
    "generate": {
      "outputs": ["src/routeTree.gen.ts", "src/paraglide/**"]
    },
    "@enduva/api#generate": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"]
    },
    "@enduva/api-client#generate": {
      "dependsOn": ["@enduva/api#generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/openapi.json"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "@enduva/ui#build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [
        "dist/**",
        "$TURBO_ROOT$/apps/apple/EnduvaKit/Sources/EnduvaKit/Colors.xcassets/**",
        "$TURBO_ROOT$/apps/apple/Enduva/Assets.xcassets/**",
        "$TURBO_ROOT$/apps/apple/EnduvaWatch/Assets.xcassets/**"
      ]
    },
    "@enduva/landing#build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/brand/final/web/**"],
      "outputs": ["dist/**"]
    },
    "@enduva/web#generate": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/i18n/messages/**"],
      "outputs": ["src/routeTree.gen.ts", "src/paraglide/**"]
    },
    "@enduva/web#build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/i18n/messages/**"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit", "generate", "^generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit", "generate", "^generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "transit", "generate"],
      "outputs": []
    },
    "@enduva/api#test": {
      "dependsOn": ["build", "^build", "transit"],
      "outputs": []
    },
    "@enduva/web#test": {
      "dependsOn": ["build", "^build", "transit", "generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/i18n/messages/**"],
      "outputs": []
    },
    "@enduva/tools#test": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#format:check": {
      "cache": false
    }
  }
}
