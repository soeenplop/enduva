{
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": ["packages/config/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "transit"],
      "outputs": []
    },
    "@enduva/tools#test": {
      "cache": false
    },
    "//#format:check": {
      "cache": false
    }
  }
}
