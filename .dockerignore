# Build context of deploy/Dockerfile (the repository root). Allowlist: everything is excluded, then only the build
# inputs are let back in. Credential and env files (`.npmrc`, `.env*`, `.envrc`, Docker or cloud configs) can never
# reach a layer or the build cache, wherever they sit. No build step needs a credential.
*

# Workspace root and the packages the images build from. tools/package.json only, because it is a workspace
# importer of the lockfile.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!turbo.json
!tools/package.json
!apps/api
!apps/web
!apps/landing
!packages
!assets/brand/final/web
!deploy/landing.nginx.conf

# Excluded again inside the allowed directories: installs, build output, caches, generated sources (the build
# regenerates them, as in a clean checkout) and any credential or env file.
**/node_modules
**/dist
**/.turbo
**/coverage
**/.tanstack
**/.DS_Store
**/.npmrc
**/.yarnrc*
**/.envrc
**/.env
**/.env.*
**/.netrc
**/.docker
**/*.pem
**/*.key
apps/*/src/routeTree.gen.ts
apps/*/src/paraglide
apps/*/project.inlang/cache
apps/*/tsconfig.negative.json
packages/api-client/src/generated
